APP_VERSION=2026.08.21-1
APP_BASE_URL=https://designbao.example.com
WEB_PORT=3000

POSTGRES_DB=designbao
POSTGRES_USER=designbao
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL_INTERNAL=postgresql://designbao:replace-with-a-long-random-password@postgres:5432/designbao

MINIO_ROOT_USER=designbao
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=designbao-uploads

SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=数据管理员

WEB_IMAGE=designbao-web:local
WORKER_IMAGE=designbao-worker:local
