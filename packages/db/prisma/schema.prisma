generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationLevel {
  NATIONAL
  REGION
  CITY
}

enum UserRole {
  ADMIN
  REGION_MANAGER
  CITY_MANAGER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  UNKNOWN
}

enum UploadStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum IssueSeverity {
  ERROR
  WARNING
}

enum PeriodGrain {
  DAY
  WEEK
  MONTH
  CUSTOM
}

enum MetricUnit {
  COUNT
  RATE
}

enum MetricDirection {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum MetricSource {
  CALCULATED
  IMPORTED
}

enum MerchantClassification {
  A
  A_RISK
  B
  C_CANDIDATE
  C
  ELIMINATED
}

enum RuleEntityType {
  PROJECT
  MERCHANT
}

enum RuleHitStatus {
  ACTIVE
  RESOLVED
  CONFIRMED
  DISMISSED
}

enum MerchantOverrideType {
  CONFIRM_C
  TEMP_EXEMPT
  PERMANENT_EXCLUDE
  MANUAL_CLASSIFICATION
}

enum JobType {
  IMPORT
  METRICS
  RULES
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AuditEntityType {
  USER
  UPLOAD_BATCH
  MERCHANT
  PROJECT
  RULE_HIT
}

model Organization {
  id              String            @id @default(cuid())
  code            String?           @unique
  name            String
  level           OrganizationLevel
  path            String            @unique
  parentId        String?
  parent          Organization?     @relation("OrganizationTree", fields: [parentId], references: [id])
  children        Organization[]    @relation("OrganizationTree")
  userScopes      UserScope[]
  merchants       Merchant[]
  projects        Project[]
  projectSnapshots ProjectSnapshot[]
  metricSnapshots MetricSnapshot[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([parentId])
  @@index([level])
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  passwordHash        String
  name                String
  role                UserRole
  active              Boolean           @default(true)
  scopes              UserScope[]
  sessions            Session[]
  uploadedBatches     UploadBatch[]
  confirmedClassifications MerchantClassificationSnapshot[] @relation("ClassificationConfirmer")
  merchantOverrides   MerchantOverride[]
  auditLogs           AuditLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model UserScope {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Merchant {
  id                      String                           @id
  name                    String
  organizationId          String
  organization            Organization                     @relation(fields: [organizationId], references: [id])
  active                  Boolean                          @default(true)
  facts                   Json                             @default("{}")
  projects                Project[]
  projectSnapshots        ProjectSnapshot[]
  metricSnapshots         MetricSnapshot[]
  classificationSnapshots MerchantClassificationSnapshot[]
  ruleHits                RuleHit[]
  overrides               MerchantOverride[]
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@index([organizationId])
  @@index([name])
}

model Project {
  id               String        @id
  sourceProjectId  String
  merchantId       String
  organizationId   String
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  organization     Organization  @relation(fields: [organizationId], references: [id])
  assignedAt       DateTime
  status           ProjectStatus @default(UNKNOWN)
  followWithin30m  Boolean?
  needsAnalyzed    Boolean?
  hardInvite       Boolean?
  needsCoaching    Boolean?
  coached          Boolean?
  improved         Boolean?
  snapshots        ProjectSnapshot[]
  ruleHits         RuleHit[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([merchantId])
  @@index([sourceProjectId])
  @@index([organizationId])
  @@index([assignedAt])
  @@unique([sourceProjectId, merchantId], name: "project_source_merchant")
}

model UploadBatch {
  id              String       @id @default(cuid())
  fileName        String
  fileHash        String
  objectKey       String?
  dataDate        DateTime     @db.Date
  status          UploadStatus @default(QUEUED)
  uploadedById    String?
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  totalRows       Int          @default(0)
  acceptedRows    Int          @default(0)
  warningCount    Int          @default(0)
  errorCount      Int          @default(0)
  failureStage    String?
  failureMessage  String?
  rows            UploadRow[]
  errors          UploadError[]
  projectSnapshots ProjectSnapshot[]
  metricSnapshots MetricSnapshot[]
  ruleHits        RuleHit[]
  jobs            Job[]
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([fileHash, dataDate])
  @@index([dataDate, status])
}

model UploadRow {
  id          String      @id @default(cuid())
  batchId     String
  batch       UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceSheet String
  sourceRow   Int
  raw         Json
  canonical   Json?
  createdAt   DateTime    @default(now())

  @@unique([batchId, sourceSheet, sourceRow], name: "upload_source_row")
}

model UploadError {
  id          String        @id @default(cuid())
  batchId     String
  batch       UploadBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceSheet String
  sourceRow   Int?
  field       String?
  code        String
  severity    IssueSeverity
  message     String
  rawValue    Json?
  createdAt   DateTime      @default(now())

  @@index([batchId, severity])
}

model ProjectSnapshot {
  id               String        @id @default(cuid())
  dataDate         DateTime      @db.Date
  projectId        String
  sourceProjectId  String
  merchantId       String
  organizationId   String
  uploadBatchId    String
  project          Project       @relation(fields: [projectId], references: [id])
  merchant         Merchant      @relation(fields: [merchantId], references: [id])
  organization     Organization  @relation(fields: [organizationId], references: [id])
  uploadBatch      UploadBatch   @relation(fields: [uploadBatchId], references: [id])
  status           ProjectStatus @default(UNKNOWN)
  followWithin30m  Boolean?
  needsAnalyzed    Boolean?
  hardInvite       Boolean?
  sopCompliant     Boolean       @default(false)
  needsCoaching    Boolean?
  coached          Boolean?
  improved         Boolean?
  raw              Json          @default("{}")
  createdAt        DateTime      @default(now())

  @@unique([dataDate, projectId], name: "project_snapshot_per_day")
  @@index([sourceProjectId, dataDate])
  @@index([merchantId, dataDate])
  @@index([organizationId, dataDate])
}

model MetricDefinition {
  id             String          @id
  name           String
  groupId        String
  groupName      String
  unit           MetricUnit
  direction      MetricDirection
  source         MetricSource
  sortOrder      Int
  enabled        Boolean         @default(true)
  formulaVersion String          @default("v1")
  snapshots      MetricSnapshot[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([groupId, sortOrder])
}

model MetricSnapshot {
  id             String           @id @default(cuid())
  metricId       String
  metric         MetricDefinition @relation(fields: [metricId], references: [id])
  grain          PeriodGrain
  periodStart    DateTime
  periodEnd      DateTime
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  merchantId     String?
  merchant       Merchant?        @relation(fields: [merchantId], references: [id])
  dimensionKey   String
  value          Decimal?         @db.Decimal(18, 4)
  numerator      Decimal?         @db.Decimal(18, 4)
  denominator    Decimal?         @db.Decimal(18, 4)
  source         MetricSource
  sourceBatchId  String
  sourceBatch    UploadBatch      @relation(fields: [sourceBatchId], references: [id])
  formulaVersion String
  createdAt      DateTime         @default(now())

  @@unique([metricId, grain, periodStart, organizationId, dimensionKey, sourceBatchId], name: "metric_snapshot_grain")
  @@index([organizationId, periodStart])
  @@index([merchantId, periodStart])
}

model MerchantClassificationSnapshot {
  id               String                 @id @default(cuid())
  merchantId       String
  merchant         Merchant               @relation(fields: [merchantId], references: [id])
  dataDate         DateTime               @db.Date
  classification   MerchantClassification
  suggested        MerchantClassification
  reason           String
  evidence         Json
  ruleVersion      String
  requiresConfirmation Boolean            @default(false)
  confirmedById    String?
  confirmedBy      User?                  @relation("ClassificationConfirmer", fields: [confirmedById], references: [id])
  effectiveAt      DateTime
  createdAt        DateTime               @default(now())

  @@unique([merchantId, dataDate])
  @@index([classification, dataDate])
}

model RuleHit {
  id             String         @id @default(cuid())
  code           String
  version        String
  entityType     RuleEntityType
  entityId       String
  merchantId     String?
  merchant       Merchant?      @relation(fields: [merchantId], references: [id])
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  dataDate       DateTime       @db.Date
  status         RuleHitStatus  @default(ACTIVE)
  evidence       Json
  reason         String
  sourceBatchId  String
  sourceBatch    UploadBatch    @relation(fields: [sourceBatchId], references: [id])
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@unique([code, entityType, entityId, dataDate, version])
  @@index([merchantId, dataDate])
  @@index([projectId, dataDate])
}

model MerchantOverride {
  id             String                  @id @default(cuid())
  merchantId     String
  merchant       Merchant                @relation(fields: [merchantId], references: [id])
  type           MerchantOverrideType
  classification MerchantClassification?
  startDate      DateTime                @db.Date
  endDate        DateTime?               @db.Date
  reason         String
  createdById    String
  createdBy      User                    @relation(fields: [createdById], references: [id])
  createdAt      DateTime                @default(now())

  @@index([merchantId, startDate, endDate])
}

model AuditLog {
  id           String          @id @default(cuid())
  actorId      String?
  actor        User?           @relation(fields: [actorId], references: [id])
  action       String
  entityType   AuditEntityType
  entityId     String
  reason       String?
  beforeValue  Json?
  afterValue   Json?
  metadata     Json?           @default("{}")
  createdAt    DateTime        @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Job {
  id             String       @id @default(cuid())
  type           JobType
  status         JobStatus    @default(QUEUED)
  sourceBatchId  String?
  sourceBatch    UploadBatch? @relation(fields: [sourceBatchId], references: [id])
  payload        Json
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  lockedBy       String?
  lockedAt       DateTime?
  availableAt    DateTime     @default(now())
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([type, sourceBatchId])
  @@index([status, availableAt])
}
